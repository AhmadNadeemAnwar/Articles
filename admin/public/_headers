# Applied by Cloudflare to every response from admin.ahmadnadeem.dev.
#
# connect-src names the API origin. If the Render service is renamed or recreated, change it here
# and in .env.production together.
#
# The admin app renders everything as text (no raw HTML) and may not be framed. The only thing it
# loads from another site is uploaded pictures, which come from the API (img-src names it). 'unsafe-inline' is only for style="" attributes, never for scripts.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://articles-api-jkvr.onrender.com; font-src 'self'; connect-src 'self' https://articles-api-jkvr.onrender.com https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  X-Robots-Tag: noindex, nofollow, noarchive

# The page shell is never cached, so a new deploy is picked up at once. (Cloudflare merges the
# headers of every matching rule, so Cache-Control must not appear in the /* block above.)
/
  Cache-Control: no-store
/index.html
  Cache-Control: no-store

# Filenames under /assets are content-hashed, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
