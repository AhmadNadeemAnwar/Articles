{
  "ConnectionStrings": {
    "Default": "Data Source=articles.db"
  },
  "Jwt": {
    "Issuer": "articles",
    "Audience": "articles-web",
    "Key": "",
    "ExpiryMinutes": 1440
  },
  "Security": {
    "CheckPwnedPasswords": true
  },
  "Turnstile": {
    "SecretKey": ""
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*"
}
